# STKSZ CAPITAL — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp `.env` olarak kaydedin ve GERÇEK değerleri doldurun.
# `.env` asla depoya commit edilmez; bu şablon (`.env.example`) commit edilir.
#
# Üretim sürümü öncesinde tüm alanların doldurulması gerekir.
# Boş değerlerle yayın yapmak için `PRODUCTION_RELEASE=true npm run check:production-config`
# komutu uyarı verir ve aşağıdaki değerler eksikse başarısız olur (exit 1).

# Google Gemini API anahtarı — YALNIZCA sunucu ortamında kullanılır.
# `server/stksz-ai-server.js` tarafından okunur, istemciye/loglara asla yazılmaz.
GEMINI_API_KEY=

# Google Sign-In OAuth Client ID (Web) — uygulama Google ile kayıt/giriş için kullanır.
# https://console.cloud.google.com/apis/credentials adresinden alınır.
ENV_GOOGLE_CLIENT_ID=

# Apple Sign-In Services ID (Web) — uygulama Apple ile kayıt/giriş için kullanır.
# https://developer.apple.com hesabından alınır.
ENV_APPLE_CLIENT_ID=

# Sunucu portu (varsayılan 8787).
# PORT=8787